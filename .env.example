# Server-side environment file for prompeteer_server (Django backend).
# Copy this to `.env` on the VPS and fill in real values. NEVER commit the
# real .env - it is gitignored and dockerignored on purpose.
#
# This file documents every variable name the app reads. No real secrets
# below - placeholders only.

# --- Core Django ---
# DJANGO_DEBUG must be "0"/false in production. Leaving it unset also
# defaults to False.
DJANGO_DEBUG=0
# Required in production (DJANGO_DEBUG=0) - generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
# Comma-separated list of hostnames this server answers to (Traefik's Host
# rule and Django's ALLOWED_HOSTS should match).
ALLOWED_HOSTS=api.yourdomain.com

# Trusted reverse proxies in front of the app (Traefik = 1). Makes DRF throttling
# read the real client IP from X-Forwarded-For instead of the proxy's IP. Use 0
# for local/dev (no proxy).
NUM_PROXIES=1

# --- Domain (used by Traefik labels in docker-compose.prod.yml) ---
DOMAIN=api.yourdomain.com
# Email used for Let's Encrypt ACME account registration/expiry notices.
ACME_EMAIL=admin@yourdomain.com

# --- CORS / CSRF (comma-separated, full scheme+host, no trailing slash) ---
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# --- Database (Postgres; the `db` service in docker-compose.prod.yml) ---
POSTGRES_DB=prompeteer
POSTGRES_USER=prompeteer
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable
POSTGRES_CONN_MAX_AGE=60

# --- Django superuser (first-run only; entrypoint.sh creates it if all
# three are set and no such user already exists) ---
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# --- Password/token salts ---
BACKEND_PASSWORD_SALT=
BACKEND_SALT=

# --- Email/SMTP (used to send the login PIN via pyotp-backed flow) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# --- Google OAuth ---
# Rotate the client secret before production launch - the old one was
# committed to git history. See DEPLOYMENT.md.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.yourdomain.com/api/v1/auth_api/google/callback/
GOOGLE_OAUTH_REDIRECT_URI_SSR=https://api.yourdomain.com/api/v1/auth_api/google/callback/ssr/

# --- OpenRouter OAuth ---
OPENROUTER_PROVISIONING_KEY=
OPENROUTER_CLIENT_ID=
OPENROUTER_CLIENT_SECRET=
OPENROUTER_AUTH_URL=
OPENROUTER_TOKEN_URL=
OPENROUTER_REDIRECT_URI=https://api.yourdomain.com/api/v1/auth_api/openrouter/callback/

# --- Microsoft OAuth ---
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_AUTH_URL=
MS_TOKEN_URL=
MS_REDIRECT_URI=https://api.yourdomain.com/api/v1/auth_api/microsoft/callback/

# --- GitHub OAuth ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_AUTH_URL=
GITHUB_TOKEN_URL=
GITHUB_REDIRECT_URI=https://api.yourdomain.com/api/v1/auth_api/github/callback/

# --- Third-party API keys used server-side ---
ZERUH_API_KEY=
MAILEROO_API_KEY=

# --- AI provider keys (used by chat_api's model-calling features via
# openai/litellm) ---
OPENAI_API_KEY=
