# Prompeteer Server - example environment configuration.
# Copy to `.env` and fill in real values. NEVER commit a real `.env` file.
# This is consumed by the custom loader in prompeteer_server/settings.py
# (plain KEY=VALUE lines; lines prefixed with "set " (Windows-style) are also accepted).

# --- Django core ---
# Required in production (DEBUG=False). In DEBUG mode an ephemeral dev-only
# value is used automatically with a warning if left unset.
SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False

# Comma-separated list of allowed hosts. Falls back to a built-in default list if unset.
ALLOWED_HOSTS=127.0.0.1,localhost

# Required in production (DEBUG=False). Salt used when hashing user passwords server-side.
BACKEND_PASSWORD_SALT=change-me-to-a-long-random-string

# Toggle SSL redirect + HSTS in production (set to False for a local prod-like run without TLS).
SECURE_SSL=True

# --- Database ---
# Leave DB_HOST blank to use the local SQLite fallback (settings.py DATABASES
# block only switches to PostgreSQL when DB_HOST or DB_ENGINE is set).
DB_HOST=
DB_NAME=prompeteer_db
DB_USER=prompeteer_user
DB_PASSWORD=change-me
DB_PORT=5432
DB_SSL=False
# Connection pooling: seconds a DB connection is kept alive and reused (Postgres only).
DB_CONN_MAX_AGE=60

# --- JWT (SIMPLE_JWT) ---
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- Third-party API keys ---
ZERUH_API_KEY=

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=change-me
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=no-reply@example.com

# --- OAuth: Google ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_OAUTH_REDIRECT_URI_SSR=

# --- OAuth: OpenRouter ---
OPENROUTER_CLIENT_ID=
OPENROUTER_CLIENT_SECRET=
OPENROUTER_REDIRECT_URI=

# --- OAuth: GitHub ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# --- OAuth: Microsoft ---
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=

# --- Redis (CACHES / CHANNEL_LAYERS / Celery broker) ---
# Leave blank to use LocMemCache / InMemoryChannelLayer and run Celery tasks
# synchronously in-process (no Redis, no channels-redis/celery packages imported).
REDIS_URL=redis://127.0.0.1:6379/0

# --- MinIO / S3-compatible object storage (MEDIA storage) ---
# Leave AWS_S3_ENDPOINT_URL blank to use local filesystem storage under MEDIA_ROOT
# (no django-storages/boto3 imported).
AWS_S3_ENDPOINT_URL=http://127.0.0.1:9000
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
AWS_STORAGE_BUCKET_NAME=prompeteer-media
AWS_S3_REGION_NAME=us-east-1

# --- Celery ---
# Default to REDIS_URL above when unset. Leave both blank (with REDIS_URL blank
# too) to run tasks synchronously in-process (CELERY_TASK_ALWAYS_EAGER).
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
